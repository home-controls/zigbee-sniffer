# Copy to sdkconfig.secrets (git-ignored), fill in, then build.
# If sdkconfig already exists, delete it (or run: idf.py reconfigure) so these are picked up.
CONFIG_BRIDGE_WIFI_SSID="your-wifi-ssid"
CONFIG_BRIDGE_WIFI_PASSWORD="your-wifi-password"
# Any long random string (e.g. 32 hex characters). Needed for updates over Wi-Fi; empty turns them off.
CONFIG_BRIDGE_UPDATE_TOKEN=""

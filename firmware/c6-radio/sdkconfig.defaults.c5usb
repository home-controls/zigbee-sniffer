# XIAO ESP32C5 plugged straight into the Home Assistant box over USB (radio 0.3+).
# Build: idf.py -B build-c5usb -D SDKCONFIG=sdkconfig.c5usb -D SDKCONFIG_DEFAULTS=sdkconfig.defaults.c5usb set-target esp32c5 build
CONFIG_IDF_TARGET="esp32c5"
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_FREERTOS_HZ=1000

# Frames go out the USB port; the log goes to UART0 (pads D6/D7) and nowhere else, so the USB
# carries nothing but framed messages
CONFIG_SNIFF_LINK_USB=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Raw 802.15.4 radio, no Zigbee stack
CONFIG_IEEE802154_ENABLED=y
CONFIG_IEEE802154_RX_BUFFER_SIZE=60

# The XIAO ESP32C5 has no antenna switch: keep an antenna on its U.FL socket
CONFIG_SNIFF_XIAO_RF_SWITCH=n

# Updates from the app over the USB boot on trial and are kept only if the link works
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
